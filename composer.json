{
    "name": "imanaging-document/conception-document-bundle",
    "description": "Bundle de conception documentaire",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Imanaging\\ConceptionDocumentBundle\\": "src/"
        }
