<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="imanaging_conception_document.conception_document" class="Imanaging\ConceptionDocumentBundle\ConceptionDocument" public="true">
            <argument type="service" id="doctrine.orm.default_entity_manager" />
            <argument />
            <argument />
            <argument type="service" id="twig" />
            <argument type="service" id="app.conception_personnalisation_service" />
        </service>
        <service id="Imanaging\ConceptionDocumentBundle\ConceptionDocument" alias="imanaging_conception_document.conception_document" public="false" />

        <service id="imanaging_conception_document.conception_document_controller" class="Imanaging\ConceptionDocumentBundle\Controller\ConceptionDocumentController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="container.service_subscriber"/>
            <argument type="service" id="doctrine.orm.default_entity_manager" />
            <argument type="service" id="imanaging_conception_document.conception_document" />
            <argument type="service" id="twig" />
        </service>

        <service id="imanaging_conception_document.font_service" class="Imanaging\ConceptionDocumentBundle\Service\ConceptionFontService" public="true">
            <argument />
        </service>
        <service id="Imanaging\ConceptionDocumentBundle\Service\ConceptionFontService" alias="imanaging_conception_document.font_service" public="false" />

        <service id="imanaging_conception_document.qr_code_service" class="Imanaging\ConceptionDocumentBundle\Service\ConceptionQrCodeService" public="true" />
        <service id="Imanaging\ConceptionDocumentBundle\Service\ConceptionQrCodeService" alias="imanaging_conception_document.qr_code_service" public="false" />

        <service id="imanaging_conception_document.font_controller" class="Imanaging\ConceptionDocumentBundle\Controller\ConceptionDocumentFontController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="container.service_subscriber"/>
            <argument type="service" id="imanaging_conception_document.font_service" />
            <argument type="service" id="twig" />
            <argument />
        </service>

        <service id="imanaging_conception_document.twig_functions" class="Imanaging\ConceptionDocumentBundle\Twig\TwigFunctions">
            <argument type="service" id="app.conception_personnalisation_service" />
            <argument />
            <argument type="service" id="imanaging_conception_document.font_service" />
            <argument type="service" id="imanaging_conception_document.qr_code_service" />
            <tag name="twig.extension" />
        </service>
    </services>
</container>
