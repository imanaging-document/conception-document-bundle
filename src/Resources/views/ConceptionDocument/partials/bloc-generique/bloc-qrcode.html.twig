<input type="hidden" name="type_bloc" value="bloc_qrcode">

<div class="mb-3">
  <label for="qrcode_content" class="form-label">Contenu du QR code</label>
  <textarea
    id="qrcode_content"
    name="qrcode_content"
    class="form-control"
    rows="4"
    placeholder="URL, texte ou variable personnalisable"
    required></textarea>
  <div class="form-text">
    Le contenu peut utiliser les mêmes variables de personnalisation qu'un bloc texte.
  </div>
</div>
