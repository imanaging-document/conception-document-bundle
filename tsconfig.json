{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": ".typescript-build"
  },
  "include": ["assets/editor/**/*.ts", "assets/editor/geometry.js", "assets/editor/history.js"]
}
